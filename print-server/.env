# URL of your Railway server
SERVER_URL=https://your-app.railway.app

# Printer type: EPSON or STAR
PRINTER_TYPE=EPSON

# Printer interface — choose one:
# Network (most common in restaurants):
PRINTER_IFACE=tcp://192.168.1.100:9100
# USB on Windows:
# PRINTER_IFACE=//./USB001
# Windows shared printer:
# PRINTER_IFACE=\\.\printer_name

# Must match server's PRINT_SERVER_SECRET
PRINT_SECRET=print_server_secret_key
